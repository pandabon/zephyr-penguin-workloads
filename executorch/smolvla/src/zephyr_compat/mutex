// <mutex> for Zephyr. The Zephyr SDK's libstdc++ is built for the "single" thread model
// (no gthreads), so its <mutex> declares std::lock_guard/unique_lock/scoped_lock/once_flag but
// NOT std::mutex. ExecuTorch's XNNPACK backend and threadpool use std::mutex, so this shim (put
// first on the include path by the app's CMakeLists.txt) includes the real header and adds
// std::mutex on top of Zephyr's POSIX pthread_mutex_t (CONFIG_POSIX_THREADS=y).
// This replaces the old fork's per-file edits from <mutex> to <posix_mutex> (commits a05cfbfb0,
// 4d0ec2152 of pandabon/zephyr-chipyard-sw's third-party/executorch, Jinsheng Xu), which used
// Zephyr's include/zephyr/posix/posix_mutex (a std::mutex + lock_guard only).
#pragma once

#include_next <mutex>
#include <pthread.h>

namespace std {

class mutex {
 public:
  mutex() { pthread_mutex_init(&m_, nullptr); }
  ~mutex() { pthread_mutex_destroy(&m_); }
  mutex(const mutex&) = delete;
  mutex& operator=(const mutex&) = delete;
  void lock() { pthread_mutex_lock(&m_); }
  void unlock() { pthread_mutex_unlock(&m_); }
  bool try_lock() { return pthread_mutex_trylock(&m_) == 0; }
  pthread_mutex_t* native_handle() { return &m_; }

 private:
  pthread_mutex_t m_;
};

} // namespace std
