mainmenu "Atlas upstream host tests"

config ATLAS_KERNELS_TIMEOUT_MCYCLES
	int "Per-wait timeout in host mcycle ticks (millions)"
	default 400
	help
	  How long the host waits for Atlas to signal "halted" (or dbg0 != 0 in
	  alu_basic) before declaring TIMEOUT, forcing execControl=0 and moving
	  on. Measured with the HOST's mcycle, so the wall time is
	  value / core clock: 400 M = ~4 s at 100 MHz, ~8 s at 50 MHz.
	  The kernels run for at most a few million Atlas cycles.

config ATLAS_KERNELS_RACE_TESTS
	bool "Run the concurrent IMEM-write tests (optA end-JAL, lower-first)"
	default y
	help
	  Both tests overwrite IMEM while Atlas executes a ~500000-iteration
	  busy loop and depend on the host finishing ~30 MMIO accesses before
	  the loop ends. A FAIL there can be timing (slow host link) instead of
	  broken hardware; turn off to get only deterministic tests.

config ATLAS_KERNELS_VMEM_VECTOR
	bool "Run RVV (vector load/store) accesses to VMEM"
	default y
	help
	  vmem_vector and the Saturn transform step of pause_resume use vle32/
	  vse32 on the Atlas VMEM window. Turn off to isolate scalar-only access
	  if a vector access to VMEM hangs the bus.

source "Kconfig.zephyr"
